{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Naturkort for norske datasentre – pilot",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "generatedAt", "scope", "sources", "cards"],
  "properties": {
    "schemaVersion": {"const": "1.0.0"},
    "generatedAt": {"type": "string", "format": "date"},
    "scope": {"type": "string", "minLength": 1},
    "sources": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/source"}},
    "cards": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/card"}}
  },
  "$defs": {
    "refs": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "publisher", "url", "publishedAt", "documentDate", "accessedAt", "access", "locator", "dateNote"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "title": {"type": "string", "minLength": 1},
        "publisher": {"type": "string", "minLength": 1},
        "url": {"type": "string", "format": "uri", "pattern": "^https://"},
        "publishedAt": {"type": ["string", "null"]},
        "documentDate": {"type": ["string", "null"]},
        "updatedAt": {"type": ["string", "null"]},
        "version": {"type": ["string", "null"]},
        "accessedAt": {"type": "string", "format": "date"},
        "access": {"enum": ["fulltext", "api_response", "reference_only", "access_failed"]},
        "locator": {"type": "string", "minLength": 1},
        "dateNote": {"type": "string", "minLength": 1},
        "localEvidence": {"type": ["string", "null"]}
      }
    },
    "uncertainty": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "confidence", "reason"],
      "properties": {
        "type": {"enum": ["qualitative", "unknown"]},
        "confidence": {"enum": ["high", "medium", "low", "unknown"]},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "finding": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "evidenceKind", "validTime", "sourceIds", "locator", "uncertainty"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "statement": {"type": "string", "minLength": 1},
        "evidenceKind": {"enum": ["report_finding", "authority_statement", "spatial_screening", "documented_change", "knowledge_gap"]},
        "validTime": {"type": ["string", "null"]},
        "sourceIds": {"$ref": "#/$defs/refs"},
        "locator": {"type": "string", "minLength": 1},
        "uncertainty": {"$ref": "#/$defs/uncertainty"}
      }
    },
    "ku": {
      "type": "object",
      "additionalProperties": false,
      "required": ["component", "status", "documentType", "scopeNote", "sourceIds"],
      "properties": {
        "component": {"type": "string", "minLength": 1},
        "status": {"enum": ["found_fulltext", "found_reference_only", "planned_not_obtained", "not_found_in_search", "access_failed"]},
        "documentType": {"type": "string", "minLength": 1},
        "scopeNote": {"type": "string", "minLength": 1},
        "sourceIds": {"$ref": "#/$defs/refs"}
      }
    },
    "screening": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "inputCrsStatus", "spatialRelation", "areaCalculationApproved", "actualHabitatLossM2", "knowledgeCoverage", "resultFile", "limitations"],
      "properties": {
        "status": {"enum": ["performed_preliminary", "not_performed"]},
        "inputCrsStatus": {"enum": ["unconfirmed", "confirmed", "not_available"]},
        "spatialRelation": {"enum": ["bbox_candidate", "conditional_polygon_intersection", "not_computed"]},
        "areaCalculationApproved": {"const": false},
        "actualHabitatLossM2": {"type": "null"},
        "knowledgeCoverage": {"enum": ["unknown", "partial"]},
        "resultFile": {"type": ["string", "null"]},
        "limitations": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
      },
      "allOf": [{"if": {"properties": {"status": {"const": "not_performed"}}}, "then": {"properties": {"spatialRelation": {"const": "not_computed"}, "resultFile": {"type": "null"}}}}]
    },
    "card": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "projectId", "name", "status", "planIds", "geometryRole", "scopeNote", "ku", "baseline", "change", "consequence", "knowledge_gap", "screening", "review", "nextActions"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "projectId": {"enum": ["hamar", "gromstul", "narvik"]},
        "name": {"type": "string", "minLength": 1},
        "status": {"enum": ["screening_only", "insufficient_evidence"]},
        "planIds": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
        "geometryRole": {"enum": ["regulatory_plan_extent", "not_acquired"]},
        "scopeNote": {"type": "string", "minLength": 1},
        "ku": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/ku"}},
        "baseline": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/finding"}},
        "change": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/finding"}},
        "consequence": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/finding"}},
        "knowledge_gap": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/finding"}},
        "screening": {"$ref": "#/$defs/screening"},
        "review": {
          "type": "object", "additionalProperties": false,
          "required": ["reviewer", "reviewedAt", "status", "scope"],
          "properties": {
            "reviewer": {"type": "string", "minLength": 1},
            "reviewedAt": {"type": "string", "format": "date"},
            "status": {"const": "limited_desk_review"},
            "scope": {"type": "string", "minLength": 1}
          }
        },
        "nextActions": {
          "type": "array", "minItems": 1,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["owner", "action", "evidenceRequired"],
            "properties": {
              "owner": {"type": "string", "minLength": 1},
              "action": {"type": "string", "minLength": 1},
              "evidenceRequired": {"type": "string", "minLength": 1}
            }
          }
        }
      }
    }
  }
}

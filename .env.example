# Copy to .env and fill in values locally. Never commit .env.
# Used by the Next.js app and ODP synchronization scripts.
# In Vercel: add ODP_API_KEY as Sensitive/Secret for Production and Preview.
# NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN must be a public pk.* token.

# Secret: server/import scripts only. Do not prefix with NEXT_PUBLIC_.
ODP_API_KEY=
ODP_API_BASE_URL=https://api.hubocean.earth
ODP_COLLECTION_ID=dc64cd07-753a-4956-be81-50dc60743ffa

# Leave blank until the datasets have actually been created in ODP.
ODP_PROJECTS_DATASET_ID=
ODP_CLAIMS_DATASET_ID=
ODP_GEOMETRIES_DATASET_ID=
ODP_NATURE_WATER_DATASET_ID=
ODP_SOURCES_DATASET_ID=

# Public browser token (pk.*), restricted to the demo's allowed domains.
# Do not use a secret Mapbox token (sk.*) here.
NEXT_PUBLIC_MAPBOX_ACCESS_TOKEN=

# Local development URL; set the final public app URL in Vercel when deployed.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
